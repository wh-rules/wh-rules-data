{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "catalogRevision", "defaultFamily", "families"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogRevision": { "$ref": "manifest.json#/$defs/revision" },
    "defaultFamily": { "const": "standard" },
    "families": {
      "type": "object",
      "required": ["standard"],
      "propertyNames": { "$ref": "manifest.json#/$defs/family" },
      "additionalProperties": {
        "type": "object",
        "required": ["currentBySchema", "releases"],
        "additionalProperties": false,
        "properties": {
          "currentBySchema": {
            "type": "object",
            "required": ["1"],
            "additionalProperties": false,
            "properties": { "1": { "$ref": "manifest.json#/$defs/tag" } }
          },
          "releases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/release" } }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["en", "ru"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 }
      }
    },
    "release": {
      "type": "object",
      "required": ["family", "revision", "exportRevision", "tag", "rulesetRef", "baseRulesetRef", "names", "scope", "highlights", "changeRefs", "effectiveFrom", "effectiveTo", "appDataVersion", "mfmVersion", "manifest", "archive", "publishedAt"],
      "additionalProperties": false,
      "properties": {
        "family": { "$ref": "manifest.json#/$defs/family" },
        "revision": { "$ref": "manifest.json#/$defs/revision" },
        "exportRevision": { "$ref": "manifest.json#/$defs/revision" },
        "tag": { "$ref": "manifest.json#/$defs/tag" },
        "rulesetRef": { "$ref": "manifest.json#/$defs/rulesetRef" },
        "baseRulesetRef": { "$ref": "manifest.json#/$defs/baseRulesetRef" },
        "names": { "$ref": "#/$defs/localizedText" },
        "scope": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/localizedText" }] },
        "highlights": {
          "type": ["object", "null"],
          "required": ["en", "ru"],
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "changeRefs": { "type": "array", "items": { "type": "string" } },
        "effectiveFrom": { "type": ["null", "string"], "format": "date" },
        "effectiveTo": { "type": ["null", "string"], "format": "date" },
        "appDataVersion": { "type": "integer", "minimum": 1 },
        "mfmVersion": { "type": "string", "minLength": 1 },
        "manifest": { "$ref": "manifest.json#/$defs/download" },
        "archive": { "$ref": "manifest.json#/$defs/download" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
